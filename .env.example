PORT=5001

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=sua_senha_do_postgres
DATABASE=BackendProjetosERP
# Ou, no lugar das variáveis acima:
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco

ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@konvexjr.com.br"
ADMIN_PASSWORD="defina_uma_senha_forte"

# Origens do frontend autorizadas (CORS), separadas por vírgula.
CORS_ORIGINS=http://localhost:5173

# Opcional para containers; use os conteúdos PEM com quebras de linha escapadas.
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
# JWT_ACCESS_TTL=15m
# REFRESH_TOKEN_DIAS=7

SWAGGER_SERVER_URL=http://localhost:5001

# Só para o `npm run dev:docker`: portas no seu computador, se 5432/5001 já estiverem ocupadas.
# KONVEX_DB_PORTA=5434
# KONVEX_API_PORTA=5002

# E-mail. Com SMTP_HOST definido envia por SMTP; sem ele, em desenvolvimento escreve no console
# (e em EMAIL_PASTA_DEV/emails.jsonl); em produção sem SMTP o envio falha.
# SMTP_HOST=
# SMTP_PORTA=587
# SMTP_USUARIO=
# SMTP_SENHA=
# EMAIL_REMETENTE=Konvex Jr <nao-responda@konvexjr.com.br>
# EMAIL_PASTA_DEV=./.emails-dev
# Só e-mails desse domínio entram no cadastro (vazio = não confere). Produção: konvexjr.com.br
# EMAIL_DOMINIO=konvexjr.com.br
# Endereço do site, usado nos links dos e-mails (sem barra final).
APP_URL=http://localhost:5173
