{
    "dependencies": {
        "bcrypt": "^6.0.0",
        "dotenv": "^16.4.7",
        "express": "^4.21.2",
        "jsonwebtoken": "^9.0.2",
        "pg": "^8.23.1",
        "swagger-ui-express": "^5.0.1",
        "uuid": "^11.1.1"
    },
    "name": "backend-projetos-erp",
    "version": "0.2.0",
    "description": "API do sistema interno da Konvex Jr",
    "main": "dist/source/main.js",
    "author": "perozin.arthur@gmail.com",
    "scripts": {
        "build": "tsc",
        "migrate": "tsc && node ./dist/source/scripts/migrar.js",
        "keys": "node source/scripts/gerarChaves.js",
        "seed:admin": "tsc && node ./dist/source/scripts/seedAdmin.js",
        "main": "if [ ! -f private.key ] || [ ! -f public.key ]; then node source/scripts/gerarChaves.js; fi && tsc && node ./dist/source/main",
        "start": "npm run main",
        "dev": "npm run main",
        "test": "jest --runInBand test/",
        "test:integracao": "jest --runInBand --testMatch '**/test/integracao/**/*.int.ts'",
        "clean": "rm -rf dist/*/",
        "dados:ficticios": "node scripts/dados-ficticios.mjs",
        "dev:docker": "docker compose -f docker-compose.dev.yml up -d --build",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/bcrypt": "^6.0.0",
        "@types/express": "^4.17.25",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/pg": "^8.23.1",
        "@types/swagger-ui-express": "^4.1.8",
        "@types/uuid": "^10.0.0",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.14.0",
        "jest": "^30.5.2",
        "prettier": "^3.10.1",
        "ts-jest": "^29.4.4",
        "typescript": "^5.9.2",
        "typescript-eslint": "^8.72.2"
    }
}
