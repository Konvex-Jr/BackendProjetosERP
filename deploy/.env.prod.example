# Modelo do .env da VPS (/docker/erp-konvex/.env). Não guarde valores reais no git.
DB_USER=konvex
DB_PASSWORD=troque_esta_senha
DB_NAME=konvex_gestao
# Nome do volume Docker onde o PostgreSQL guarda os dados (confira com: docker volume ls)
DB_VOLUME=erp-konvex_postgres_data
DOMINIO=erp.konvexjr.com.br
# Nome do certresolver configurado no Traefik (confira nos labels do compose atual)
CERT_RESOLVER=letsencryptresolver
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@konvexjr.com.br
ADMIN_PASSWORD=defina_uma_senha_forte
