# Modelo do .env da VPS (/docker/erp-konvex/.env). Não guarde valores reais no git.
DB_USER=konvex
DB_PASSWORD=troque_esta_senha
# Nome do banco. O .env da VPS usa DATABASE=...; DB_NAME também funciona (tem prioridade).
DATABASE=konvex_gestao
# Opcionais: só defina se o seu ambiente for diferente da VPS da Konvex.
# Volume do banco (padrão erp-konvex_konvex_postgres_data; confira com docker inspect konvex-db)
# DB_VOLUME=erp-konvex_konvex_postgres_data
# DOMINIO=erp.konvexjr.com.br
# Certresolver do Traefik (padrão letsencrypt)
# CERT_RESOLVER=letsencrypt
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@konvexjr.com.br
ADMIN_PASSWORD=defina_uma_senha_forte
